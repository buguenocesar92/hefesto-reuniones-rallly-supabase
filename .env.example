# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
COMPOSE_PROJECT_NAME=hefesto-reuniones
PUBLIC_URL=https://reuniones.tu-dominio.cl
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_USER=rallly_app
DB_PASSWORD=GENERAR
SECRET_PASSWORD=GENERAR
DB_SSLMODE=require
DB_SSLROOTCERT=/certs/ca.crt
DATABASE_URL=
DIRECT_DATABASE_URL=
DB_SSLCERT=/certs/ca.crt
SUPABASE_DEDICATED_CONFIRMED=true
SUPABASE_DATA_API_DISABLED=true
INITIAL_ADMIN_EMAIL=REEMPLAZAR@example.invalid
# Lista NOMINAL de administradores: nunca comodines ni patrones de dominio.
ALLOWED_EMAILS=REEMPLAZAR@example.invalid
SUPPORT_EMAIL=REEMPLAZAR@example.invalid
NOREPLY_EMAIL=REEMPLAZAR@example.invalid
SMTP_READY=false
SMTP_HOST=REEMPLAZAR
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
