{
  "software": "hefesto-reuniones",
  "version": "4.15.4",
  "database": "supabase-postgresql",
  "piezas": [
    "public.dump"
  ],
  "requiere": [
    "app"
  ],
  "arranca": [
    "app"
  ],
  "pasos": [
    [
      "stop",
      "app"
    ],
    [
      "pieza",
      "public.dump"
    ]
  ],
  "comandos": {
    "public.dump": [
      "run",
      "--rm",
      "--no-deps",
      "-T",
      "--entrypoint",
      "pg_dump",
      "dbtools",
      "--format=custom",
      "--schema=public",
      "--no-owner",
      "--no-acl"
    ]
  },
  "env_requeridas": [
    "PUBLIC_URL",
    "DB_HOST",
    "DB_USER",
    "DB_PASSWORD",
    "SECRET_PASSWORD",
    "INITIAL_ADMIN_EMAIL",
    "ALLOWED_EMAILS"
  ],
  "env_secretas": [
    "DB_PASSWORD",
    "SECRET_PASSWORD",
    "SMTP_PASSWORD"
  ],
  "env_min_len": 32,
  "env_reglas": [
    {
      "nombre": "ALLOWED_EMAILS",
      "no_vacio": true,
      "sin_comodin": true,
      "sin_dominio": true
    },
    {
      "nombre": "INITIAL_ADMIN_EMAIL",
      "incluida_en": "ALLOWED_EMAILS"
    }
  ]
}
